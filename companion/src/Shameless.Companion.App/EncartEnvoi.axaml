<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Shameless.Companion.App"
             x:Class="Shameless.Companion.App.EncartEnvoi"
             x:DataType="app:EnvoiViewModel">
  <StackPanel Spacing="10">
    <!-- Dernier résultat : accepté, en revue, rejeté, refusé, erreur. -->
    <TextBlock Text="{Binding DernierResultat}" TextWrapping="Wrap" Foreground="#a1a1aa"
               IsVisible="{Binding DernierResultat, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- Procédure d'échec (ADR 0020) : ambre. -->
    <Border IsVisible="{Binding EchecVisible}" Background="#1Afbbf24" BorderBrush="#66fbbf24"
            BorderThickness="1" CornerRadius="10" Padding="14">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="M12 3 L22 20 L2 20 Z M12 9 L12 14 M12 17 L12 17.5" Stroke="#fbbf24" StrokeThickness="1.8"
                StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform" />
          <TextBlock Text="Rapport non envoyé" FontWeight="SemiBold" Foreground="#fbbf24" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="#fafafa"
                   Text="Ouvre le fichier et donne-le à l'une de ces personnes, qui l'importera sur le site." />
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding LigneSuperadministrateur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Superadministrateur" Foreground="#a1a1aa" Width="130" />
            <TextBlock Text="{Binding LigneSuperadministrateur}" Foreground="#fafafa" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding LigneAdministrateur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="Administrateur" Foreground="#a1a1aa" Width="130" />
            <TextBlock Text="{Binding LigneAdministrateur}" Foreground="#fafafa" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Ouvrir le fichier" Click="OnOuvrirFichier" Background="#fbbf24" Foreground="#09090b"
                  CornerRadius="8" />
          <Button Content="Réessayer l'envoi" Click="OnReessayer" Background="Transparent" Foreground="#fafafa"
                  BorderBrush="#1Affffff" BorderThickness="1" CornerRadius="8" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
