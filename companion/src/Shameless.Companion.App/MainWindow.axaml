<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Shameless.Companion.App"
        x:Class="Shameless.Companion.App.MainWindow"
        x:DataType="app:FenetreViewModel"
        Title="Shameless Companion"
        Icon="/Assets/companion.png"
        Width="460" SizeToContent="Height" CanResize="False"
        Background="#09090b" Foreground="#fafafa"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="URL de l'Instance" />
    <TextBox Text="{Binding UrlInstance}" Watermark="https://shameless.example" />
    <TextBlock Text="Code Companion" />
    <TextBox Text="{Binding Code}" PasswordChar="•" />
    <Button Content="Se connecter" Click="OnConnecter" IsEnabled="{Binding !Occupe}" />
    <Separator />
    <TextBlock Text="{Binding EtatClientLol}" />
    <TextBlock Text="{Binding EtatConnexion}" TextWrapping="Wrap" FontWeight="SemiBold" />
    <TextBlock Text="{Binding Serie}" TextWrapping="Wrap" />
    <app:EncartEnvoi x:Name="EncartEnvoi" />
  </StackPanel>
</Window>
