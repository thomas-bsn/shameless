# Cette configuration n'est chargée qu'une fois l'Instance installée (voir entrypoint.sh).
# Derrière un proxy qui termine le TLS, on garde ses en-têtes X-Forwarded-* (réseau privé seulement).
{
	servers {
		trusted_proxies static private_ranges
	}
}

# Adresse du site, écrite par le wizard : ":80" en local (HTTP), un nom de domaine en production (HTTPS automatique).
{$SHAMELESS_SITE_ADDRESS::80} {
	encode gzip

	# Le wizard d'installation reste joignable le temps de confirmer son état final, puis s'arrête.
	handle /_setup/* {
		reverse_proxy wizard:8080
	}

	# L'API est servie sous /api ; le préfixe est retiré avant de la joindre.
	handle_path /api/* {
		reverse_proxy api:8080
	}

	# Le front, build Vite. Les assets ont un nom haché : cache permanent, et 404 s'ils manquent.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Toute autre route de la SPA renvoie index.html.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
