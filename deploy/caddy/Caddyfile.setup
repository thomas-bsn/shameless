# Configuration de Caddy tant que l'Instance n'est pas installée : seul le wizard répond.
# En HTTP sur le port 80, et en HTTPS auto-signé sur le port 443 pour saisir les secrets sur un
# canal chiffré (le navigateur affichera un avertissement de certificat : c'est attendu).
{
	auto_https disable_redirects
	default_sni wizard.local
}

http://:80 {
	reverse_proxy wizard:8080
}

https://:443 {
	tls internal
	reverse_proxy wizard:8080
}
