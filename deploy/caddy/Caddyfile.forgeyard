# Forgeyard termine TLS et transmet les requêtes en HTTP au port 80 de Caddy.
http://{$SHAMELESS_SITE_ADDRESS::80} {
	encode gzip

	handle /_setup/* {
		reverse_proxy wizard:8080
	}

	handle_path /api/* {
		reverse_proxy api:8080
	}

	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
