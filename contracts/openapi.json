  "components": {
    "schemas": {
      "AuthUserResponse": {
        "required": [
          "valid",
          "discordUserId",
          "username",
          "avatarUrl",
          "isAdmin"
        ],
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "discordUserId": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "avatarUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "isAdmin": {
            "type": "boolean"
          }
        }
      },
      "CreateGameRequest": {
        "required": [
          "blueTeam",
          "redTeam",
          "seriesId",
          "boFormat"
        ],
        "type": "object",
        "properties": {
          "blueTeam": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "redTeam": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "seriesId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "boFormat": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "CreateGameResponse": {
        "required": [
          "gameId",
          "playedAt",
          "seriesId",
          "message"
        ],
        "type": "object",
        "properties": {
          "gameId": {
            "type": "integer",
            "format": "int32"
          },
          "playedAt": {
            "type": "string",
            "format": "date-time"
          },
          "seriesId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "CreatePlayerRequest": {
        "required": [
          "prenom",
          "riotId"
        ],
        "type": "object",
        "properties": {
          "prenom": {
            "type": "string"
          },
          "riotId": {
            "type": "string"
          }
        }
      },
      "GameHistoryListResponse": {
        "required": [
          "games"
        ],
        "type": "object",
        "properties": {
          "games": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeriesHistoryResponse"
            }
          }
        }
      },
      "GameHistoryResponse": {
        "required": [
          "id",
          "seriesId",
          "playedAt",
          "winner",
          "blueTeam",
          "redTeam"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "seriesId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "playedAt": {
            "type": "string",
            "format": "date-time"
          },
          "winner": {
            "type": [
              "null",
              "string"
            ]
          },
          "blueTeam": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameParticipantDto"
            }
          },
          "redTeam": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameParticipantDto"
            }
          }
        }
      },
      "GameParticipantDto": {
        "required": [
          "prenom",
          "riotId",
          "rankTier",
          "rankDivision",
          "cost"
        ],
        "type": "object",
        "properties": {
          "prenom": {
            "type": "string"
          },
          "riotId": {
            "type": "string"
          },
          "rankTier": {
            "type": [
              "null",
              "string"
            ]
          },
          "rankDivision": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "cost": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "LinkPlayerRequest": {
        "required": [
          "playerId"
        ],
        "type": "object",
        "properties": {
          "playerId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PendingGameParticipant": {
        "required": [
          "playerId",
          "team",
          "prenom"
        ],
        "type": "object",
