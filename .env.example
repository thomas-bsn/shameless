# Fichier facultatif : copier en .env pour ajuster des réglages avancés (ADR 0015).
# L'installation de base ne le demande pas : au premier `docker compose up -d`, le wizard collecte
# l'adresse publique, l'application Discord (Client ID, Client Secret, serveur, administrateurs),
# génère les secrets internes (mot de passe de la base) et les écrit dans le volume instance-config.
# Les variables ci-dessous sont lues à chaque démarrage. Ne jamais commiter .env.

# --- Session -----------------------------------------------------------------
# Durée de la session en jours, prolongée à chaque utilisation.
SESSION_LIFETIME_DAYS=14

# --- Riot ---------------------------------------------------------------------
# Clé de l'API Riot (optionnelle). Sans clé, le rafraîchissement des rangs est désactivé
# et l'ajout de joueurs échoue.
RIOT_API_KEY=

# --- Soirée -------------------------------------------------------------------
# Période sans game au bout de laquelle la Soirée ouverte se ferme seule (hh:mm:ss).
# Une Soirée avec une série en cours n'est jamais fermée automatiquement.
SOIREE_AUTO_CLOSE_AFTER=03:00:00

# --- Bot Discord (facultatif, ADR 0013) --------------------------------------
# Sans ces variables, l'Instance démarre : pas de webhooks, pas de candidats vocaux,
# routes /bot refusées. Générer chaque secret avec : openssl rand -hex 32
# URL publique du bot (son API interne derrière son reverse proxy), ex. https://bot.example.org
SHAMELESS_BOT_URL=
# Clé de l'API pour appeler le bot (candidats vocaux) : même valeur que SHAMELESS_BOT_API_KEY du bot.
SHAMELESS_BOT_API_KEY=
# Secret HMAC des webhooks API -> bot : même valeur que SHAMELESS_WEBHOOK_SECRET du bot.
SHAMELESS_WEBHOOK_SECRET=
# Clé du bot pour appeler l'API (routes /bot) : distincte des deux précédentes. Vide = refusé.
SHAMELESS_BOT_TO_API_KEY=
# URL publique du site, pour les liens envoyés au bot (récap de Game, Série).
SHAMELESS_WEB_URL=

# --- Instance et clips (ADR 0014) ------------------------------------------
# Fuseau horaire IANA de la communauté : il découpe les jours (un clip est rattaché à
# l'unique Game lancée le jour de sa publication).
SHAMELESS_TIMEZONE=Europe/Paris
# Taille maximale d'une vidéo de clip déposée par le bot, en octets (500 Mo par défaut).
# Les vidéos sont conservées dans le volume nommé api-clips.
SHAMELESS_CLIPS_MAX_BYTES=524288000

# --- Exposition ---------------------------------------------------------------
# L'adresse servie par Caddy vient du wizard (adresse publique saisie). Pour un domaine, Caddy doit
# être joignable sur les ports 80 et 443 : mapper SHAMELESS_HTTP_PORT=80 et SHAMELESS_HTTPS_PORT=443.
SHAMELESS_HTTP_PORT=8080
SHAMELESS_HTTPS_PORT=8443

# --- Images (facultatif) ------------------------------------------------------
# Par défaut, le compose tire ghcr.io/thomas-bsn/shameless-{api,migrate,proxy,wizard}:latest.
# Pour une instance reproductible, épingler une version (tag vX.Y.Z publié, sans le « v »).
# SHAMELESS_VERSION=0.2.0
# SHAMELESS_IMAGE_PREFIX=ghcr.io/thomas-bsn/shameless
