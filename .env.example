# Copier ce fichier en .env puis remplir les valeurs. Ne jamais commiter .env.

# --- Base de données ---------------------------------------------------------
POSTGRES_DB=shameless
POSTGRES_USER=shameless
# Mot de passe de la base (requis). Générer par exemple : openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Discord (https://discord.com/developers/applications) -------------------
# Identifiant et secret de l'application OAuth2 (requis).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID du serveur Discord de la communauté : seuls ses membres peuvent se connecter (requis).
DISCORD_GUILD_ID=
# URL de callback, à déclarer aussi dans les Redirects OAuth2 de l'application (requis).
# En local : http://localhost:8080/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback

# --- Session et droits --------------------------------------------------------
# Origines autorisées comme URL de retour après connexion, séparées par des virgules.
# Les chemins locaux (« /… ») sont toujours acceptés. Exemple : https://shameless.example
AUTH_ALLOWED_RETURN_ORIGINS=
# IDs Discord des admins, séparés par des virgules.
ADMIN_DISCORD_IDS=
# Durée de la session en jours, prolongée à chaque utilisation.
SESSION_LIFETIME_DAYS=14

# --- Riot ---------------------------------------------------------------------
# Clé de l'API Riot (optionnelle). Sans clé, le rafraîchissement des rangs est désactivé
# et l'ajout de joueurs échoue.
RIOT_API_KEY=

# --- Exposition ---------------------------------------------------------------
# Adresse servie par Caddy : « :80 » en local, ou un nom de domaine (HTTPS automatique).
SHAMELESS_SITE_ADDRESS=:80
SHAMELESS_HTTP_PORT=8080
SHAMELESS_HTTPS_PORT=8443

# --- Images (facultatif) ------------------------------------------------------
# Préfixe et tag des images construites ou tirées par le compose.
SHAMELESS_IMAGE_PREFIX=shameless
SHAMELESS_VERSION=local
